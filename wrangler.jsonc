{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "revo",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "revo"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "kv_namespaces": [
    {
      "binding": "CMS_KV",
      "id": "ffc317897c624d8f9cd459a5e83e637e",
      "preview_id": "2bf685a2971e48a686bbec74f26cf842"
    }
  ],
  "vars": {
    "MAIL_TO": "info@revo.qa",
    "DESIGN_VARIANT": "v2",
    "ADMIN_USERNAME": "admin"
  },
  "routes": [
    { "pattern": "revo.qa/*", "zone_name": "revo.qa" },
    { "pattern": "www.revo.qa/*", "zone_name": "revo.qa" }
  ],
  "workers_dev": true,
  "env": {
    "staging": {
      "name": "revo-staging",
      "compatibility_date": "2025-12-01",
      "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "revo-staging"
        }
      ],
      "images": {
        "binding": "IMAGES"
      },
      "kv_namespaces": [
        {
          "binding": "CMS_KV",
          "id": "ffc317897c624d8f9cd459a5e83e637e",
          "preview_id": "2bf685a2971e48a686bbec74f26cf842"
        }
      ],
      "vars": {
        "MAIL_TO": "info@revo.qa",
        "DESIGN_VARIANT": "v2",
        "ADMIN_USERNAME": "admin"
      }
    },
    "design": {
      "name": "revo-design",
      "compatibility_date": "2025-12-01",
      "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "revo-design"
        }
      ],
      "images": {
        "binding": "IMAGES"
      },
      "kv_namespaces": [
        {
          "binding": "CMS_KV",
          "id": "ffc317897c624d8f9cd459a5e83e637e",
          "preview_id": "2bf685a2971e48a686bbec74f26cf842"
        }
      ],
      "vars": {
        "MAIL_TO": "info@revo.qa",
        "DESIGN_VARIANT": "v2",
        "ADMIN_USERNAME": "admin"
      }
    }
  }
}
