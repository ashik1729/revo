{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "revo",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "revo"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "MAIL_TO": "info@revo.qa"
  },
  "env": {
    "staging": {
      "name": "revo-staging",
      "compatibility_date": "2025-12-01",
      "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "revo-staging"
        }
      ],
      "images": {
        "binding": "IMAGES"
      },
      "vars": {
        "MAIL_TO": "info@revo.qa",
        "DESIGN_VARIANT": "v1"
      }
    },
    "design": {
      "name": "revo-design",
      "compatibility_date": "2025-12-01",
      "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "revo-design"
        }
      ],
      "images": {
        "binding": "IMAGES"
      },
      "vars": {
        "MAIL_TO": "info@revo.qa",
        "DESIGN_VARIANT": "v2"
      }
    }
  }
}
