generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SiteSettings {
  id          Int    @id @default(1)
  companyName String
  address     String
  phone       String
  email       String
  whatsapp    String
  updatedAt   DateTime @updatedAt
}

model SiteTranslation {
  locale               String   @id
  tagline              String
  heroEyebrow          String
  heroHeadline         String
  heroSubheadline      String
  heroCtaLabel         String
  heroCtaHref          String
  aboutTitle           String
  aboutDescription     String
  productsSectionTitle String
  servicesSectionTitle String
  contactTitle         String
  contactDescription   String
  updatedAt            DateTime @updatedAt
}

model NavItem {
  id         String               @id @default(cuid())
  href       String
  orderIndex Int                  @default(0)
  isActive   Boolean              @default(true)
  translations NavItemTranslation[]
  updatedAt  DateTime             @updatedAt
}

model NavItemTranslation {
  id        String   @id @default(cuid())
  navItemId String
  locale    String
  label     String
  navItem   NavItem  @relation(fields: [navItemId], references: [id], onDelete: Cascade)

  @@unique([navItemId, locale])
}

model Product {
  id          String               @id @default(cuid())
  icon        String
  orderIndex  Int                  @default(0)
  isActive    Boolean              @default(true)
  translations ProductTranslation[]
  updatedAt   DateTime             @updatedAt
}

model ProductTranslation {
  id        String   @id @default(cuid())
  productId String
  locale    String
  title     String
  description String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
}

model Service {
  id          String               @id @default(cuid())
  icon        String
  orderIndex  Int                  @default(0)
  isActive    Boolean              @default(true)
  translations ServiceTranslation[]
  updatedAt   DateTime             @updatedAt
}

model ServiceTranslation {
  id        String   @id @default(cuid())
  serviceId String
  locale    String
  title     String
  description String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, locale])
}

model Inquiry {
  id          String   @id @default(cuid())
  fullName    String
  email       String
  phone       String?
  inquiryType String
  specificItem String?
  message     String?
  createdAt   DateTime @default(now())
}
