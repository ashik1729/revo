generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SiteSettings {
  id                  Int      @id @default(1)
  companyName         String
  address             String
  phone               String
  email               String
  whatsapp            String
  heroImageUrl        String   @default("")
  aboutImageUrl       String   @default("")
  contactBannerUrl    String   @default("")
  contactSideImageUrl String   @default("")
  updatedAt           DateTime @updatedAt
}

model SiteTranslation {
  locale                    String   @id
  tagline                   String
  heroEyebrow               String
  heroHeadline              String
  heroSubheadline           String
  heroCtaLabel              String
  heroCtaHref               String
  heroSecondaryCtaLabel     String   @default("")
  heroSecondaryCtaHref      String   @default("#products")
  heroImageAlt              String   @default("")
  trustBadge1               String   @default("")
  trustBadge2               String   @default("")
  trustBadge3               String   @default("")
  aboutTitle                String
  aboutDescription          String
  aboutExtra                String   @default("")
  aboutImageAlt             String   @default("")
  visionTitle               String   @default("")
  visionText                String   @default("")
  missionTitle              String   @default("")
  missionText               String   @default("")
  productsSectionTitle      String
  productsSectionDescription String  @default("")
  servicesSectionTitle      String
  servicesSectionDescription String  @default("")
  faqSectionTitle           String   @default("")
  faqSectionDescription     String   @default("")
  contactTitle              String
  contactDescription        String
  updatedAt                 DateTime @updatedAt
}

model NavItem {
  id           String               @id @default(cuid())
  href         String
  orderIndex   Int                  @default(0)
  isActive     Boolean              @default(true)
  translations NavItemTranslation[]
  updatedAt    DateTime             @updatedAt
}

model NavItemTranslation {
  id        String  @id @default(cuid())
  navItemId String
  locale    String
  label     String
  navItem   NavItem @relation(fields: [navItemId], references: [id], onDelete: Cascade)

  @@unique([navItemId, locale])
}

model Product {
  id           String               @id @default(cuid())
  imageUrl     String
  orderIndex   Int                  @default(0)
  isActive     Boolean              @default(true)
  translations ProductTranslation[]
  updatedAt    DateTime             @updatedAt
}

model ProductTranslation {
  id          String  @id @default(cuid())
  productId   String
  locale      String
  title       String
  description String
  details     String  @default("")
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
}

model Service {
  id           String               @id @default(cuid())
  imageUrl     String
  orderIndex   Int                  @default(0)
  isActive     Boolean              @default(true)
  translations ServiceTranslation[]
  updatedAt    DateTime             @updatedAt
}

model ServiceTranslation {
  id          String  @id @default(cuid())
  serviceId   String
  locale      String
  title       String
  description String
  details     String  @default("")
  service     Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, locale])
}

model FaqItem {
  id           String            @id @default(cuid())
  orderIndex   Int               @default(0)
  isActive     Boolean           @default(true)
  translations FaqTranslation[]
  updatedAt    DateTime          @updatedAt
}

model FaqTranslation {
  id        String  @id @default(cuid())
  faqItemId String
  locale    String
  question  String
  answer    String
  faqItem   FaqItem @relation(fields: [faqItemId], references: [id], onDelete: Cascade)

  @@unique([faqItemId, locale])
}

model Inquiry {
  id           String   @id @default(cuid())
  fullName     String
  email        String
  phone        String?
  inquiryType  String
  specificItem String?
  message      String?
  createdAt    DateTime @default(now())
}
